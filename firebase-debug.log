: \"auth != null\",\n      \".write\": \"auth != null\",\n      \".indexOn\": [\"programme\", \"Programme\", \"createdAt\", \"rawTimestamp\", \"date\"],\n      \"$recordId\": {\n        \".read\": \"auth != null\",\n        \".write\": \"auth != null\"\n      }\n    },\n\n    \"fodderFarmers\": {\n      \".read\": \"auth != null\",\n      \".write\": \"auth != null\",\n      \".indexOn\": [\"programme\", \"Programme\", \"createdAt\", \"rawTimestamp\", \"date\"],\n      \"$recordId\": {\n        \".read\": \"auth != null\",\n        \".write\": \"auth != null\"\n      }\n    },\n\n    \"offtakes\": {\n      \".read\": \"auth != null\",\n      \".write\": \"auth != null\",\n      \".indexOn\": [\"programme\", \"Programme\", \"createdAt\", \"rawTimestamp\", \"date\"],\n      \"$recordId\": {\n        \".read\": \"auth != null\",\n        \".write\": \"auth != null\"\n      }\n    },\n\n    \"Onboarding\": {\n      \".read\": \"auth != null\",\n      \".write\": \"auth != null\",\n      \".indexOn\": [\"programme\", \"Programme\", \"createdAt\", \"rawTimestamp\", \"date\"],\n      \"$recordId\": {\n        \".read\": \"auth != null\",\n        \".write\": \"auth != null\"\n      }\n    },\n\n    \"AnimalHealthActivities\": {\n      \".read\": \"auth != null\",\n      \".write\": \"auth != null\",\n      \".indexOn\": [\"programme\", \"Programme\", \"createdAt\", \"rawTimestamp\", \"date\"],\n      \"$recordId\": {\n        \".read\": \"auth != null\",\n        \".write\": \"auth != null\"\n      }\n    },\n\n    \"BoreholeStorage\": {\n      \".read\": \"auth != null\",\n      \".write\": \"auth != null\",\n      \".indexOn\": [\"programme\", \"Programme\", \"createdAt\", \"rawTimestamp\", \"date\"],\n      \"$recordId\": {\n        \".read\": \"auth != null\",\n        \".write\": \"auth != null\"\n      }\n    },\n\n    \"HayStorage\": {\n      \".read\": \"auth != null\",\n      \".write\": \"auth != null\",\n      \".indexOn\": [\"programme\", \"Programme\", \"createdAt\", \"rawTimestamp\", \"date\"],\n      \"$recordId\": {\n        \".read\": \"auth != null\",\n        \".write\": \"auth != null\"\n      }\n    },\n\n    \"hrStaffDirectory\": {\n      \".read\": \"auth != null\",\n      \".write\": \"auth != null\",\n      \".indexOn\": [\"programme\", \"Programme\", \"createdAt\", \"rawTimestamp\"],\n      \"$recordId\": {\n        \".read\": \"auth != null\",\n        \".write\": \"auth != null\"\n      }\n    },\n\n    \"hrStaffMarks\": {\n      \".read\": \"auth != null\",\n      \".write\": \"auth != null\",\n      \".indexOn\": [\"programme\", \"Programme\", \"createdAt\", \"rawTimestamp\"],\n      \"$recordId\": {\n        \".read\": \"auth != null\",\n        \".write\": \"auth != null\"\n      }\n    },\n\n    \"fieldTeam\": {\n      \".read\": \"auth != null\",\n      \".write\": \"auth != null\",\n      \".indexOn\": [\"programme\", \"Programme\", \"createdAt\", \"rawTimestamp\", \"date\"]\n    },\n\n    \"prices\": {\n      \".read\": \"auth != null\",\n      \".write\": \"auth != null\"\n    },\n\n    \"smsOutbox\": {\n      \".read\": \"auth != null\",\n      \".write\": \"auth != null\",\n      \".indexOn\": [\"programme\", \"Programme\", \"createdAt\", \"rawTimestamp\", \"date\"],\n      \"$messageId\": {\n        \".read\": \"auth != null\",\n        \".write\": \"auth != null\"\n      }\n    },\n\n    \"Recent Activities\": {\n      \".read\": \"auth != null\",\n      \".write\": \"auth != null\",\n      \".indexOn\": [\"programme\", \"Programme\", \"createdAt\", \"rawTimestamp\", \"date\"],\n      \"$recordId\": {\n        \".read\": \"auth != null\",\n        \".write\": \"auth != null\"\n      }\n    },\n\n    \"Infrastructure Data\": {\n      \".read\": \"auth != null\",\n      \".write\": \"auth != null\",\n      \".indexOn\": [\"programme\", \"Programme\", \"createdAt\", \"rawTimestamp\", \"date\"],\n      \"$recordId\": {\n        \".read\": \"auth != null\",\n        \".write\": \"auth != null\"\n      }\n    },\n\n    \"Fodder Offtake Data\": {\n      \".read\": \"auth != null\",\n      \".write\": \"auth != null\",\n      \".indexOn\": [\"programme\", \"Programme\", \"createdAt\", \"rawTimestamp\", \"date\"],\n      \"$recordId\": {\n        \".read\": \"auth != null\",\n        \".write\": \"auth != null\"\n      }\n    },\n\n    \"dashboardInsights\": {\n      \".read\": \"auth != null\",\n      \".indexOn\": [\"programme\", \"date\", \"createdAt\"],\n      \"$insightId\": {\n        \".write\": \"auth != null\",\n        \".validate\": \"newData.hasChildren(['date', 'insight', 'field', 'programme', 'createdAt']) && newData.child('insight').isString() && newData.child('programme').isString()\"\n      }\n    }\n  }\n}\n"
